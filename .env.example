# ─── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_cafe_management
PORT=3000
NODE_ENV=development

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-secure-jwt-secret-at-least-8-characters
JWT_EXPIRES_IN=1d

# ─── Application URL (used in email links) ───────────────────────────────────
APP_URL=http://localhost:3000

# ─── Google OAuth2 (optional — leave blank to disable Google login) ───────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ─── Resend Email Service (optional — leave blank to disable real emails) ─────
# Get your API key at https://resend.com
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com